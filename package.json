{
  "name": "orbitalhw.jacobdanderson.net",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.13.0 <27" },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "build": "python3 scripts/build.py",
    "check": "python3 scripts/check_site.py",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "node tests/browser.test.mjs && node tests/course-lab.browser.test.mjs",
    "dev": "python3 scripts/serve.py --port 4178",
    "validate": "npm run build && npm run test && npm run check"
  }
}
